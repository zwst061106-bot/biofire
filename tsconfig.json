{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@crypto/*": ["src/lib/crypto/*"],
      "@protocol/*": ["src/lib/protocol/*"],
      "@security/*": ["src/lib/security/*"],
      "@audit/*": ["src/lib/audit/*"],
      "@policy/*": ["src/lib/policy/*"],
      "@monitoring/*": ["src/lib/monitoring/*"],
      "@persistence/*": ["src/lib/persistence/*"],
      "@logging/*": ["src/lib/logging/*"]
    }
  },
  "include": ["src/**/*", "server.ts", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}