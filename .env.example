# === BioFire MPC v6.0 — Production Environment ===
NODE_ENV=production
PORT=3000

# === Cryptography ===
BIOFIRE_API_KEY=bf_prod_256bit_hex_key_here
MPC_THRESHOLD=2
MPC_TOTAL_PARTIES=3
MPC_CURVE=secp256k1

# === Database ===
DATABASE_URL=postgresql://biofire:secure_password@postgres:5432/biofire
SQLITE_PATH=./data/biofire.db

# === Redis (Rate Limiting, Sessions, Queues) ===
REDIS_URL=redis://redis:6379

# === AWS CloudHSM / KMS ===
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/your-key-id
HSM_PROVIDER=kms

# === Audit & Compliance ===
AUDIT_DB_PATH=./data/audit.db
SOC2_AUDIT_MODE=true

# === Blockchain RPC ===
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
BTC_RPC_URL=http://localhost:8332
SOL_RPC_URL=https://api.mainnet-beta.solana.com
POLKADOT_RPC_URL=wss://rpc.polkadot.io

# === Policy ===
MAX_DAILY_SPENDING_USD=2000000
POLICY_TIMELOCK_MINUTES=30

# === Monitoring ===
METRICS_PORT=9090
SENTRY_DSN=https://your-sentry-dsn
