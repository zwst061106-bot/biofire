{
  "name": "biofire-mpc",
  "version": "6.0.0-production",
  "description": "Enterprise Multi-Party Computation Digital Asset Custody Platform",
  "type": "module",
  "license": "Proprietary",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "docker:build": "docker build -t biofire-mpc:latest -f docker/Dockerfile .",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "k8s:apply": "kubectl apply -f k8s/"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.600.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "better-sqlite3": "^11.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.6.3",
    "prom-client": "^15.1.2",
    "winston": "^3.13.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^2.1.1",
    "prettier": "^3.3.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vitest": "^4.1.10"
  }
}